{
  "_doc": "The production art root (ADR 0002). Fields: scripts/art/README.md. Sections: templates (reference images built in code), sheets (raw render -> sprites), parts (RotSprite bakes), exports (TypeScript modules), audit (extra globs to lint). Entries starting with _ are ignored.",
  "templates": {
    "rexi_x4": {
      "type": "editsheet",
      "sprite": "../reference/manu-pipeline/master_side.png",
      "n": 4
    },
    "enemy_slots": {
      "type": "slotsheet",
      "anchor": "../reference/manu-pipeline/master_side.png",
      "n": 3,
      "box": [48, 36],
      "ground": null
    },
    "icon_cells": {
      "type": "icongrid",
      "n": 12,
      "cell": 16,
      "cols": 6,
      "anchor": "hand/icon_anchor.png"
    },
    "record_cells": {
      "type": "icongrid",
      "n": 4,
      "cell": 32,
      "cols": 4,
      "anchor": "sprites/icons/inmunidad-judicial.png"
    },
    "arena_draft": {
      "type": "draft",
      "image": "../reference/arena.png",
      "size": [640, 360],
      "palette": "scene"
    },
    "arena_tiles": {
      "type": "scene_tiles",
      "draft": "templates/arena_draft_1x.png",
      "step": [200, 113]
    }
  },
  "sheets": {
    "icons": {
      "kind": "icon",
      "prompt": "prompts/icons.txt",
      "style": true,
      "refs": ["templates/icon_cells.png"],
      "palette": "icon",
      "canvas": [40, 40],
      "out": "sprites/icons-clean",
      "_names": "The model drew the icons at 2x (about 32 px) and repeated the bottom row: the large icons are cleaned here, then scripts/art/ui/icons.py picks a copy, reduces it 2:1 to 16x16 and applies the hand pass.",
      "names": [
        null,
        "mazo-automatico",
        "lluvia-de-sellos",
        "mancuernas",
        "codigo-penal",
        "citaciones-teledirigidas",
        "sentencia-firme",
        "pre-entreno",
        "receso",
        "inmunidad-judicial",
        "dia-de-pierna",
        "creatina",
        "sentencia-firme_b",
        "pre-entreno_b",
        "receso_b",
        "inmunidad-judicial_b",
        "dia-de-pierna_b",
        "creatina_b"
      ]
    },
    "record": {
      "kind": "sprite",
      "prompt": "prompts/record.txt",
      "style": true,
      "refs": ["templates/record_cells.png"],
      "palette": "icon",
      "out": "sprites/record-clean",
      "names": [null, "seal", "gavel", "wax"]
    },
    "_example_arena": {
      "kind": "scene",
      "prompt": "prompts/_example_arena_tile.txt",
      "style": true,
      "background": "none",
      "tiles": [
        ["arena_r0c0", "arena_r0c1", "arena_r0c2"],
        ["arena_r1c0", "arena_r1c1", "arena_r1c2"],
        ["arena_r2c0", "arena_r2c1", "arena_r2c2"]
      ],
      "tile_step": [200, 113],
      "crop": [0, 0, 640, 360],
      "layers": {
        "sky": { "ramps": ["sky"] }
      }
    }
  },
  "parts": {},
  "exports": {
    "icons": {
      "sprites": ["sprites/icons/*.png"],
      "format": "rows",
      "out": "src/render/art/generated"
    },
    "record": {
      "sprites": ["sprites/record/*.png"],
      "format": "rows",
      "out": "src/render/art/generated"
    }
  },
  "audit": {
    "sprites/icons/*.png": "icon",
    "sprites/record/*.png": "icon"
  }
}
