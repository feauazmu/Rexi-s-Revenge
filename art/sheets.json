  "exports": {
    "icons": {
      "sprites": ["sprites/icons/*.png"],
      "format": "rows",
      "out": "src/render/art/generated"
    },
    "record": {
      "sprites": ["sprites/record/*.png"],
      "format": "rows",
      "out": "src/render/art/generated"
    },
    "enemies": {
      "sprites": ["enemies/**/*.png"],
      "format": "rle",
      "out": "src/render/art/generated",
      "data": {
        "layout": "enemies/layout.json"
      }
    },
    "projectiles": {
      "sprites": ["projectiles/**/*.png"],
      "format": "rows",
      "out": "src/render/art/generated",
      "data": {
        "gavelPivots": "projectiles/turn/gavel/pivots.json",
        "stampPivots": "projectiles/turn/stamp/pivots.json",
        "dumbbellPivots": "projectiles/turn/dumbbell/pivots.json",
        "lawBookPivots": "projectiles/turn/law_book/pivots.json",
        "rocketPivots": "projectiles/turn/rocket/pivots.json",
        "bulletPivots": "projectiles/turn/bullet/pivots.json"
      }
    },
    "arena": {
      "sprites": [
        "sprites/arena/layers/*.png",
        "sprites/arena/ledge_*.png",
        "sprites/arena/cloud_*.png"
      ],
      "format": "rle",
      "out": "src/render/art/generated"
    },
    "rexi": {
      "_doc": "Rexi's body frames (both facings), lapel cap and aiming arms, written by scripts/art/characters/rexi.py build.",
      "sprites": ["frames/rexi/**/*.png"],
      "format": "rle",
      "out": "src/render/art/generated",
      "data": {
        "rexiArt": "frames/rexi/rexi.json"
      }
    },
    "rexi-portrait": {
      "_doc": "The Dialogue Box portrait, written by scripts/art/characters/rexi.py portrait.",
      "sprites": ["sprites/rexi/portrait.png"],
      "format": "rows",
      "out": "src/render/art/generated"
    }
  },
  "audit": {
    "sprites/icons/*.png": "icon",
    "sprites/record/*.png": "icon",
    "enemies/**/*.png": "enemy",
    "projectiles/*.png": "enemy",
    "sprites/arena/layers/*.png": "scene",
    "frames/rexi/**/*.png": "character",
    "sprites/rexi/portrait*.png": "icon",
    "sprites/rexi/*.png": "character"
  }
}
