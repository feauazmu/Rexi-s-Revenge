  "parts": {
    "gavel": {
      "src": "projectiles/gavel.png",
      "pivot": [6, 5],
      "angles": {
        "from": -135,
        "to": 180,
        "step": 45
      },
      "out": "projectiles/turn/gavel"
    },
    "stamp": {
      "src": "projectiles/stamp.png",
      "pivot": [4, 6],
      "angles": {
        "from": -135,
        "to": 180,
        "step": 45
      },
      "out": "projectiles/turn/stamp"
    },
    "dumbbell": {
      "src": "projectiles/dumbbell.png",
      "pivot": [6, 4],
      "angles": {
        "from": 0,
        "to": 157.5,
        "step": 22.5
      },
      "out": "projectiles/turn/dumbbell"
    },
    "law_book": {
      "src": "projectiles/law_book.png",
      "pivot": [7, 5],
      "angles": {
        "from": -90,
        "to": 90,
        "step": 22.5
      },
      "out": "projectiles/turn/law_book"
    },
    "rocket": {
      "src": "projectiles/rocket.png",
      "pivot": [7, 4],
      "angles": {
        "from": -90,
        "to": 90,
        "step": 22.5
      },
      "out": "projectiles/turn/rocket"
    },
    "bullet": {
      "src": "projectiles/bullet.png",
      "pivot": [3, 2],
      "angles": {
        "from": -90,
        "to": 90,
        "step": 22.5
      },
      "out": "projectiles/turn/bullet"
    }
  },
  "exports": {
    "enemies": {
      "sprites": ["enemies/**/*.png"],
      "format": "rle",
      "out": "src/render/art/generated"
    },
    "projectiles": {
      "sprites": ["projectiles/**/*.png"],
      "format": "rows",
      "out": "src/render/art/generated",
      "data": {
        "gavelPivots": "projectiles/turn/gavel/pivots.json",
        "stampPivots": "projectiles/turn/stamp/pivots.json",
        "dumbbellPivots": "projectiles/turn/dumbbell/pivots.json",
        "lawBookPivots": "projectiles/turn/law_book/pivots.json",
        "rocketPivots": "projectiles/turn/rocket/pivots.json",
        "bulletPivots": "projectiles/turn/bullet/pivots.json"
      }
    }
  },
  "audit": {
    "enemies/**/*.png": "enemy",
    "projectiles/*.png": "enemy"
  }
}
